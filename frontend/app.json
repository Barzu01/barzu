{
  "expo": {
    "name": "SafedAuto",
    "slug": "safedauto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safedauto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safedauto.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Сфотографировать автомобиль для объявления",
        "NSPhotoLibraryUsageDescription": "Выбрать фото автомобиля из галереи"
      }
    },
    "android": {
      "package": "com.safedauto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0066CC"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к вашим фото для добавления изображений автомобилей"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Приложению нужен доступ к камере для фотографирования автомобилей"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0066CC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "safedauto"
      }
    }
  }
}
